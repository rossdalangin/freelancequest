{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "freelancequest/platform",
    "type": "project",
    "description": "FREELANCEQUEST — Gamified Virtual Assistant & Freelancing Career Simulator",
    "keywords": ["freelancing", "virtual-assistant", "gamification", "career-simulator"],
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
